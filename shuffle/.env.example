# Sao chép thành /opt/Shuffle/.env. Không commit file .env thật.
BACKEND_HOSTNAME=shuffle-backend
FRONTEND_PORT=3001
FRONTEND_PORT_HTTPS=3443
SHUFFLE_SWARM_CONFIG=run
SHUFFLE_APP_REPLICAS=3
SHUFFLE_WORKER_IMAGE=ghcr.io/shuffle/shuffle-worker:latest
SHUFFLE_OPENSEARCH_URL=https://shuffle-opensearch:9200
SHUFFLE_OPENSEARCH_USERNAME=admin

# Sinh riêng từng secret bằng: openssl rand -hex 32
OPENSEARCH_INITIAL_ADMIN_PASSWORD=
SHUFFLE_OPENSEARCH_PASSWORD=
SHUFFLE_ENCRYPTION_MODIFIER=
